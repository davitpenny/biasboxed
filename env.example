# Only needed for local testing — on Railway set these in the Variables tab instead

# Required: your bot's token from the Discord Developer Portal
DISCORD_BOT_TOKEN=your_bot_token_here

# Required: the webhook URL for your bias channel
TARGET_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxx/xxxxx

# Strongly recommended: your numeric Discord user ID
ALLOWED_DISCORD_USER_ID=

# Optional overrides
WEBHOOK_USERNAME=
WEBHOOK_AVATAR_URL=
DEFAULT_SESSION_LABEL=
